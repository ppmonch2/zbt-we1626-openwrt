#!/bin/sh
# Provision from a user-owned FAT32 USB key, never from GitHub.
set -eu
DIR=/tmp/dh-firstboot
mkdir -p "$DIR"
CRED=
USB_DEV=
try=0
while [ "$try" -lt 30 ] && [ -z "$CRED" ]; do
  for dev in /dev/sda1 /dev/sdb1 /dev/sda /dev/sdb; do
    [ -b "$dev" ] || continue
    if mount -t vfat -o ro,noexec,nosuid,nodev "$dev" "$DIR" 2>/dev/null; then
      if [ -f "$DIR/DACHA.TXT" ]; then CRED="$DIR/DACHA.TXT"; USB_DEV="$dev"; break; fi
      umount "$DIR" 2>/dev/null || true
    fi
  done
  [ -n "$CRED" ] && break
  sleep 2
  try=$((try+1))
done
if [ -z "$CRED" ]; then logger -t DH-SETUP 'No USB key, Wi-Fi disabled'; exit 1; fi
if ! grep -qx 'DACHA-V1' "$CRED"; then umount "$DIR" || true; exit 1; fi
WIFI_SSID="$(sed -n 's/^WIFI_SSID=//p' "$CRED" | head -n 1 | tr -d '\r')"
[ -n "$WIFI_SSID" ] || WIFI_SSID='DachaHeat-Setup'
SSID_LEN="$(printf '%s' "$WIFI_SSID" | wc -c)"
if [ "$SSID_LEN" -lt 1 ] || [ "$SSID_LEN" -gt 32 ]; then
  logger -t DH-SETUP 'Invalid Wi-Fi SSID length'; umount "$DIR" || true; exit 1
fi
WIFI_PASS="$(sed -n 's/^WIFI_PSK=//p' "$CRED" | head -n 1 | tr -d '\r')"
ROOT_HASH="$(sed -n 's/^ROOT_SHA512=//p' "$CRED" | head -n 1 | tr -d '\r')"
WIFI_LEN="$(printf '%s' "$WIFI_PASS" | wc -c)"
if [ "$WIFI_LEN" -lt 8 ] || [ "$WIFI_LEN" -gt 63 ] || ! printf '%s' "$WIFI_PASS" | grep -Eq '^[A-Za-z0-9]+$'; then
  logger -t DH-SETUP 'Invalid Wi-Fi password'; umount "$DIR" || true; exit 1
fi
if ! printf '%s' "$ROOT_HASH" | grep -Eq '^\$6\$[A-Za-z0-9./]{8,32}\$[A-Za-z0-9./]{70,100}$'; then
  logger -t DH-SETUP 'Invalid root hash'; umount "$DIR" || true; exit 1
fi
[ -f /etc/shadow ] || { umount "$DIR" || true; exit 1; }
[ -s /etc/config/wireless ] || wifi config > /etc/config/wireless
RADIO="$(uci show wireless | sed -n 's/^wireless\.\([^.]*\)=wifi-device$/\1/p' | head -n 1)"
if [ -z "$RADIO" ]; then logger -t DH-SETUP 'Wi-Fi radio not detected'; umount "$DIR" || true; exit 1; fi
IFACE="$(uci show wireless | sed -n 's/^wireless\.\([^.]*\)=wifi-iface$/\1/p' | head -n 1)"
[ -n "$IFACE" ] || IFACE="$(uci add wireless wifi-iface)"
uci set "wireless.$RADIO.disabled=0"
uci set "wireless.$IFACE.device=$RADIO"
uci set "wireless.$IFACE.mode=ap"
uci set "wireless.$IFACE.network=lan"
uci set "wireless.$IFACE.ssid=$WIFI_SSID"
uci set "wireless.$IFACE.encryption=psk2"
uci set "wireless.$IFACE.key=$WIFI_PASS"
uci set "wireless.$IFACE.disabled=0"
uci commit wireless
sed -i "s|^root:[^:]*:|root:$ROOT_HASH:|" /etc/shadow
uci -q delete network.wanusb 2>/dev/null || true
uci set network.wanusb=interface
uci set network.wanusb.device=usb0
uci set network.wanusb.proto=dhcp
uci set network.wanusb.metric=10
uci commit network
for zone in $(uci show firewall | sed -n 's/^firewall\.\([^.]*\)=zone$/\1/p'); do
  [ "$(uci -q get "firewall.$zone.name")" = wan ] || continue
  uci -q add_list "firewall.$zone.network=wanusb" || true
done
uci commit firewall
if uci -q get uhttpd.heatbridge >/dev/null 2>&1; then
  uci set uhttpd.heatbridge.disabled=0
  uci commit uhttpd
fi
umount "$DIR" || true
logger -t DH-SETUP "Wi-Fi and root configured from $USB_DEV; no passwords logged"
exit 0
