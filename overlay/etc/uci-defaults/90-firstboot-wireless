#!/bin/sh
# EXPERIMENTAL first boot access using build-specific passwords.
# Actual WE1626 hardware/bootloader compatibility UNVERIFIED.
set -eu
if [ ! -s /etc/config/wireless ]; then
    wifi config >/etc/config/wireless
fi
RADIO="$(uci show wireless | sed -n 's/^wireless\.\([^.]*\)=wifi-device$/\1/p' | head -n 1)"
[ -n "$RADIO" ] || { logger -t DH-WIFI 'No Wi-Fi radio in UCI'; exit 1; }
IFACE="$(uci show wireless | sed -n 's/^wireless\.\([^.]*\)=wifi-iface$/\1/p' | head -n 1)"
if [ -z "$IFACE" ]; then
    IFACE="$(uci add wireless wifi-iface)"
fi
uci set "wireless.$RADIO.disabled=0"
uci set "wireless.$IFACE.device=$RADIO"
uci set "wireless.$IFACE.mode=ap"
uci set "wireless.$IFACE.network=lan"
uci set "wireless.$IFACE.ssid=__DH_SSID__"
uci set "wireless.$IFACE.encryption=psk2"
uci set "wireless.$IFACE.key=__DH_WIFI_PASSWORD__"
uci set "wireless.$IFACE.disabled=0"
uci commit wireless

# USB ZTE CDC Ethernet usually appears as usb0 (not guaranteed).
# Keep main LAN and modem independent: if modem differs, IT must adjust.
uci set network.wanusb='interface'
uci set network.wanusb.device='usb0'
uci set network.wanusb.proto='dhcp'
uci set network.wanusb.metric='10'
uci commit network
for s in $(uci show firewall | sed -n 's/^firewall\.\([^.]*\)=zone$/\1/p'); do
    if [ "$(uci -q get "firewall.$s.name")" = "wan" ]; then
        uci -q add_list "firewall.$s.network=wanusb"
    fi
done
uci commit firewall

# Set an individual password BEFORE exposing the AP: never ship blank root.
[ -f /etc/shadow ] || { logger -t DH-WIFI 'Shadow unavailable'; exit 1; }
sed -i 's|^root:[^:]*:|root:__DH_ROOT_HASH__:|' /etc/shadow
logger -t DH-WIFI 'First-boot WPA2 network and root hash set'
exit 0
