#!/opt/bin/sh
# One queue job on stdin. No secrets on stdout; durable at-most-once claims on USB.
set -eu
umask 077
export PATH=/opt/bin:/opt/sbin:/usr/bin:/bin:/usr/sbin:/sbin
base="${HEATBRIDGE_PREFIX:-/opt}"
device_child=''
cleanup() {
 if [ -n "$device_child" ]; then
  kill "$device_child" 2>/dev/null || true
  wait "$device_child" 2>/dev/null || true
 fi
}
trap cleanup EXIT
trap 'exit 1' INT TERM HUP
state="$base/var/lib/heatbridge-alice/requests"
mkdir -p "$state"
chmod 700 "$state"
job="$(head -c 2049)"
[ "${#job}" -le 2048 ] || exit 1
fields="$(printf '%s' "$job" | jq -er '
 if (type=="object" and (.id|if type!="string" then false else
  length==64 and (explode|all((.>=48 and .<=57) or (.>=97 and .<=102))) end) and
 (.heater=="h1" or .heater=="h2" or .heater=="h3" or .heater=="h4") and
 (.value|type=="number" and .==floor) and
 ((.action=="set" and .value>=5 and .value<=30) or
  (.action=="mode" and (.value==0 or .value==1))) and
 (.expires_at|type=="number" and .>now and .<=now+4))
 then [.id,.heater,.action,.value,.expires_at]|@tsv
 else error("invalid_job") end
' 2>/dev/null)" || exit 1
# All fields have already been restricted to hex, fixed enums and numbers.
# Read them without eval and without starting four more jq processes on MIPS.
IFS="$(printf '\t')" read -r id heater action value expires <<EOF
$fields
EOF
record="$state/$id"
if ! mkdir "$record" 2>/dev/null; then
 # A crashed/in-progress claim is deliberately never executed again.
 if [ -s "$record/result.json" ]; then cat "$record/result.json"; else
  printf '{"id":"%s","heater":"%s","action":"%s","value":%s,"ok":false,"error":"already_claimed_may_have_been_applied"}\n' "$id" "$heater" "$action" "$value"
 fi
 exit 0
fi
printf '%s\n' "$job" > "$record/job.json"
printf '{"id":"%s","heater":"%s","action":"%s","value":%s,"ok":false,"error":"unconfirmed_may_have_been_applied"}\n' "$id" "$heater" "$action" "$value" > "$record/result.json"
device_ok=false
if jq -e --arg id "$heater" --argjson expires "$expires" \
 '($expires>now) and (.heaters[$id].verified==true)' "$base/etc/heatbridge/config.json" >/dev/null 2>&1; then
 "$base/bin/heatbridge-device" "$action" "$heater" "$value" > "$record/device.json" 2>/dev/null &
 device_child=$!
 if wait "$device_child"; then device_ok=true; fi
 device_child=''
fi
if [ "$device_ok" = true ]; then
 if jq -ce --slurpfile result "$record/device.json" '
   . as $job | $result[0] as $r |
   if ($r.encrypted_session==true and $r.command_acknowledged==true and
       $r.state_echo_matches_request==true and
       (if $job.action=="set" then $r.reported_target==$job.value else $r.device_mode==$job.value end))
   then {id,heater,action,value,ok:true,observed_at:now,result:($r|{
     encrypted_session,command_acknowledged,state_echo_matches_request,reported_target,
     device_mode,current_temperature,heating_confirmed:false})}
   else empty end' "$record/job.json" > "$record/result.new" 2>/dev/null; then
  mv "$record/result.new" "$record/result.json"
 fi
fi
cat "$record/result.json"
