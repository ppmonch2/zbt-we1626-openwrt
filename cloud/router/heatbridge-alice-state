#!/opt/bin/sh
# Low-priority observations using the same reader as the local web interface.
set -eu
umask 077
export PATH=/opt/bin:/opt/sbin:/usr/bin:/bin:/usr/sbin:/sbin
base="${HEATBRIDGE_PREFIX:-/opt}"
runtime="${HEATBRIDGE_ALICE_RUNTIME:-/tmp/heatbridge-alice}"
device_runtime="${HEATBRIDGE_DEVICE_RUNTIME:-/tmp/heatbridge}"
states="$device_runtime/states"
work="$runtime/telemetry"
mkdir -p "$work" "$states"
chmod 700 "$work" "$states"
child=''
cleanup() {
 if [ -n "$child" ]; then kill "$child" 2>/dev/null || true; wait "$child" 2>/dev/null || true; fi
}
trap cleanup EXIT
trap 'exit 0' INT TERM HUP
if [ "${HEATBRIDGE_STATE_TRANSPORT:-cloud}" = disk ]; then
 . "$base/bin/heatbridge-disk-lib"
 disk_init || exit 1
else
 bucket="$(jq -r .ack_bucket "$base/etc/heatbridge/alice.json")"
 case "$bucket" in ''|*[!a-z0-9.-]*) exit 1;; esac
 [ -s "$runtime/curl.conf" ] || exit 1
fi
publish() {
 set --
 for state_id in h1 h2 h3 h4; do
  [ ! -s "$states/$state_id.json" ] || set -- "$@" "$states/$state_id.json"
 done
 # Empty stdin handles startup before the first successful observation.
 jq -cs --slurpfile config "$base/etc/heatbridge/config.json" '
  {schema:1,bridge_version:"0.2.0",published_at:now,
   devices:(map(select(.heater as $id | $config[0].heaters[$id].verified==true)) |
    map({key:.heater,value:{heater,online,observed_at,field_observed_at,
     result:(.result|{encrypted_session,reported_target,current_temperature,device_mode})}}) |
    from_entries)}' "$@" < /dev/null > "$work/upload.json" || return 1
 if [ "${HEATBRIDGE_STATE_TRANSPORT:-cloud}" = disk ]; then
  disk_http PUT /acks/state-v1.json /dev/null -H 'Content-Type: application/json' \
   --data-binary "@$work/upload.json" &
 else
  curl -q --config "$runtime/curl.conf" --proto '=https' --connect-timeout 2 \
  --max-time 3 -fsS --aws-sigv4 'aws:amz:ru-central1:s3' -X PUT \
  -H 'Content-Type: application/json' --data-binary "@$work/upload.json" \
  "https://storage.yandexcloud.net/$bucket/acks/state-v1.json" \
   > /dev/null 2> /dev/null &
 fi
 child=$!
 if wait "$child"; then
  child=''; printf '%s\n' 'published' > "$work/status"
 else
  child=''; printf '%s\n' 'state_upload_failed' > "$work/status"
 fi
}
while :; do
 for id in h1 h2 h3 h4; do
  if ! jq -e --arg id "$id" '.heaters[$id].verified==true' \
       "$base/etc/heatbridge/config.json" >/dev/null 2>&1; then
   rm -f "$states/$id.json"
   continue
  fi
  HEATBRIDGE_BACKGROUND_READ=1 "$base/bin/heatbridge-device" read "$id" \
    > /dev/null 2> /dev/null &
  child=$!
  outcome=0
  wait "$child" || outcome=$?
  child=''
  case "$outcome" in
   0|73|75) ;; # Busy/preempted is not evidence that a heater is offline.
   *)
    jq -cn --arg id "$id" '{heater:$id,online:false,observed_at:now,result:{}}' > "$work/offline.json"
    mv "$work/offline.json" "$states/$id.json"
    ;;
  esac
  publish || true
  sleep 2 & child=$!; wait "$child" || true; child=''
 done
 # Avoid a busy loop if all devices have been unconfigured.
 sleep 2 & child=$!; wait "$child" || true; child=''
done
