#!/opt/bin/sh
set -eu
export PATH=/opt/bin:/opt/sbin:/usr/bin:/bin:/usr/sbin:/sbin
base="${HEATBRIDGE_PREFIX:-/opt}"
pidfile="${HEATBRIDGE_ALICE_PIDFILE:-/tmp/heatbridge-alice.pid}"
agent="$base/bin/heatbridge-alice"
running() {
 [ -s "$pidfile" ] || return 1
 pid="$(cat "$pidfile")"
 case "$pid" in ''|*[!0-9]*) return 1;; esac
 [ -r "/proc/$pid/cmdline" ] && tr '\0' '\n' < "/proc/$pid/cmdline" |
  grep -Fxq -e "$agent" -e "$base/bin/heatbridge-disk-agent"
}
case "${1:-}" in
 start)
  if running; then echo 'Alice agent is already running.'; exit 0; fi
  if ! jq -e '.enabled==true' "$base/etc/heatbridge/disk.json" >/dev/null 2>&1; then
   [ -s "$base/etc/heatbridge/alice.json" ] || { echo 'Private alice.json is required.' >&2; exit 1; }
  fi
  "$agent" >/tmp/heatbridge-alice.log 2>&1 &
  printf '%s\n' "$!" > "$pidfile"
  sleep 1
  running || { echo 'Alice agent did not start. See /tmp/heatbridge-alice.log.' >&2; exit 1; }
  echo 'Alice agent is running. End-to-end delivery still requires a test.'
  ;;
 stop)
  if running; then
   kill "$pid"
   attempts=0
   while running; do
    attempts=$((attempts+1))
    [ "$attempts" -lt 35 ] || { echo 'Agent is still stopping; retry after the current network request.' >&2; exit 1; }
    sleep 1
   done
  fi
  rm -f "$pidfile"
  ;;
 status) running;;
 *) echo 'Usage: S85heatbridge-alice {start|stop|status}' >&2; exit 1;;
esac
